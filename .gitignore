# Ignore large and generated artifacts
/Resources/
logs/*.log
**/logs/*.log
hs_err_pid*.log
dependency-reduced-pom.xml
pom.xml.backup

# Ignore entire build and test directories
target/
tests/

# Common build outputs
*.class

# Eclipse/IDE project settings (can cause git index issues)
.settings/

# Python caches in resources
**/__pycache__/
*.pyc
/target/
*.jar
