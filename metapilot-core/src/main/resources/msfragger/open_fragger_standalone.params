# MSFragger open-search parameter template for the standalone
# MSFragger+Sage open-search pipeline (docs/developer/open-search-standalone-design.md).
# This is fed through uk.ac.quadram.metapilot.dbSearch.msFragger.MSFraggerParameter,
# which overrides the placeholder values below (database_name, num_threads, enzyme,
# precursor/fragment tolerance) per run. Schema verified against MSFragger 4.2's own
# parameter_files/closed_fragger.params (Nesvilab/MSFragger on GitHub) -- do not copy
# key names from older MSFragger docs/examples without checking they still apply,
# the enzyme keys in particular changed from singular (search_enzyme_name) to
# per-enzyme-slot (search_enzyme_name_1) with the addition of dual-enzyme support.
database_name = 			# overridden at runtime
num_threads = 0			# overridden at runtime; 0 = auto-detect

precursor_mass_lower = -150			# overridden at runtime; open searches use the DDA MAG FragPipe pipeline's -150/+500 Da
precursor_mass_upper = 500			# overridden at runtime
precursor_mass_units = 0			# overridden at runtime; 0 = Da (open), 1 = ppm (closed marker search)
data_type = 0			# DDA
precursor_true_tolerance = 20
precursor_true_units = 1			# ppm
fragment_mass_tolerance = 20
fragment_mass_units = 1			# ppm
calibrate_mass = 2
use_all_mods_in_first_search = 0
decoy_prefix = rev_			# must match the shared decoy FASTA's tag (core.prodb.FastaManager.addDecoy default)

deisotope = 1
deneutralloss = 1
# isotope_error stays 0 for the open searches: in a Da-wide window the +1/+2
# isotope offsets remain visible as their own delta-mass peaks, and the stage-1
# selector folds them onto the zero family itself. The closed round-1 marker
# search (round1_search_mode = closed) overrides this with 0/1/2, a ppm window
# and its own variable modifications; see MagOpenSearchHeadlessRunner.round1Settings.
isotope_error = 0
mass_offsets = 0.0
mass_offsets_detailed =
use_detailed_offsets = 0
precursor_mass_mode = selected

remove_precursor_peak = 0
remove_precursor_range = -1.500000,1.500000
intensity_transform = 0
activation_types = all
analyzer_types = all
group_variable = 0
require_precursor = 1
reuse_dia_fragment_peaks = 0

write_calibrated_mzml = 0
write_uncalibrated_mzml = 0
mass_diff_to_variable_mod = 0			# irrelevant here: this pipeline has no IonQuant/Philosopher downstream in phase 1

localize_delta_mass = 1			# recommended for open search: enables shifted-fragment scoring
delta_mass_exclude_ranges = (-1.5,3.5)
fragment_ion_series = b,y
ion_series_definitions =

labile_search_mode = off
restrict_deltamass_to = all
diagnostic_intensity_filter = 0
Y_type_masses =
diagnostic_fragments =
remainder_fragment_masses =

# Enzyme settings below are overridden at runtime via MSFraggerParameter.set(...);
# defaults here are fully-tryptic as a fallback only.
search_enzyme_name_1 = stricttrypsin
search_enzyme_cut_1 = KR
search_enzyme_nocut_1 = 
search_enzyme_sense_1 = C
allowed_missed_cleavage_1 = 2

search_enzyme_name_2 = null
search_enzyme_cut_2 =
search_enzyme_nocut_2 =
search_enzyme_sense_2 = C
allowed_missed_cleavage_2 = 2

num_enzyme_termini = 2

clip_nTerm_M = 1

# No variable modifications configured by default: open search identifies shifted
# masses via the wide precursor window itself, not via an enumerated variable-mod
# list. MSFraggerParameter.parse() discards variable_mod lines from this file; per-run
# modifications are set through MSFraggerHeadlessRunner.OpenSearchSettings.variableMods.

allow_multiple_variable_mods_on_residue = 0
max_variable_mods_per_peptide = 3
max_variable_mods_combinations = 5000

# pepXML is the output this pipeline reads (MSFraggerReader parses it directly, no
# Philosopher needed). With localize_delta_mass = 1 above, MSFragger emits the
# delta-mass localization evidence in a <ptm_result> element on each search_hit --
# scores with and without the delta mass, best/second-best localized positions, matched
# ion counts for each, and the localized sequence. That evidence is what the validation
# classifier uses to judge whether a delta mass is a real modification rather than a
# precursor mass error, and it is why localize_delta_mass = 1 is mandatory here.
# MSFragger has used both a compact attribute vocabulary (best_score_with_ptm,
# score_without_ptm, ...) and, from 4.1 onward, an expanded vocabulary
# (score_best_position, score_all_unshifted, ...). OpenSearchPepxmlReader supports
# both. Ordinary <search_score> values remain numeric engine scores and are not the
# location of this payload.
output_format = pepXML
output_report_topN = 5			# multi-candidate reporting, analogous to Sage's report_psms -- MSFragger defaults to 1 (top-hit-only), which would silently defeat "no top-hit pruning"
output_max_expect = 50
report_alternative_proteins = 1

precursor_charge = 1 4
override_charge = 0

digest_min_length = 7
digest_max_length = 50
digest_mass_range = 500.0 5000.0
max_fragment_charge = 2

track_zero_topN = 0
zero_bin_accept_expect = 0
zero_bin_mult_expect = 1

check_spectral_files = 1
minimum_peaks = 15
use_topN_peaks = 150
min_fragments_modelling = 2
min_matched_fragments = 4
minimum_ratio = 0.01
clear_mz_range = 0.0 0.0

add_Cterm_peptide = 0.0
add_Nterm_peptide = 0.0
add_Cterm_protein = 0.0
add_Nterm_protein = 0.0

add_G_glycine = 0.0
add_A_alanine = 0.0
add_S_serine = 0.0
add_P_proline = 0.0
add_V_valine = 0.0
add_T_threonine = 0.0
add_C_cysteine = 57.02146
add_L_leucine = 0.0
add_I_isoleucine = 0.0
add_N_asparagine = 0.0
add_D_aspartic_acid = 0.0
add_Q_glutamine = 0.0
add_K_lysine = 0.0
add_E_glutamic_acid = 0.0
add_M_methionine = 0.0
add_H_histidine = 0.0
add_F_phenylalanine = 0.0
add_R_arginine = 0.0
add_Y_tyrosine = 0.0
add_W_tryptophan = 0.0
add_B_user_amino_acid = 0.0
add_J_user_amino_acid = 0.0
add_O_user_amino_acid = 0.0
add_U_user_amino_acid = 0.0
add_X_user_amino_acid = 0.0
add_Z_user_amino_acid = 0.0
